# Podman quadlet: PostgreSQL for Keycloak. Lab only.
[Unit]
Description=PostgreSQL for Keycloak (lab)

[Container]
Image=docker.io/library/postgres:16
ContainerName=postgres
Network=portico-lab.network
EnvironmentFile=/etc/portico-lab/keycloak.env
Environment=POSTGRES_DB=keycloak
Environment=POSTGRES_USER=keycloak
Volume=postgres-data:/var/lib/postgresql/data:Z

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
