# Portico: multi-tenant service layer for Nutanix Prism Central.
# Runs unprivileged; CAP_NET_BIND_SERVICE lets it bind port 443.
[Unit]
Description=Portico service layer
Documentation=https://github.com/marco-fabbri/portico
After=network-online.target keycloak.service
Wants=network-online.target
# No Requires on keycloak: Portico fails closed and keeps serving when the
# identity provider is down.
# An appliance recovers by itself: a store that cannot open makes the
# process exit at once, and the default start limit (5 starts in 10 s)
# would leave the unit failed until `systemctl reset-failed`. With no
# limit it retries every RestartSec until the cause is fixed.
StartLimitIntervalSec=0

[Service]
Type=simple
User=portico
Group=portico
ExecStart=/usr/local/bin/portico serve -config /etc/portico/portico.yaml
# Restart=always: "Apply and restart" in the setup page makes the service
# exit 0 on purpose, and systemd must start it again with the stored
# settings.
Restart=always
RestartSec=2
# A tenant operation still running at stop is marked failed at the next
# start (operator retries or deletes); no need to wait for it.
TimeoutStopSec=30
LimitNOFILE=65536

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
StateDirectory=portico
ConfigurationDirectory=portico
ConfigurationDirectoryMode=0750

[Install]
WantedBy=multi-user.target
