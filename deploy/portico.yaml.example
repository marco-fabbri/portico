# Portico settings. Copy to /etc/portico/portico.yaml (mode 0640, group portico).
# Secrets are never written here: they are referenced by file path.

public:
  listen: ":443"                 # tunnel mode: "127.0.0.1:8080" with no tls block
  tls:                           # both empty = plain HTTP behind cloudflared
    cert_file: /etc/portico/tls/public.crt
    key_file: /etc/portico/tls/public.key
  prism_host: prism.msp.example  # required: public name of Prism Central
  id_host: id.msp.example        # required: public name of the identity provider
                                 # (same registrable domain as prism_host)

internal:
  admin_listen: "127.0.0.1:8443"       # health, the admin UI and the JSON API; off the
                                       # loopback it needs internal.tls (credentials)
  passthrough_listen: "127.0.0.1:9440" # raw pass-through to Prism Central, local login allowed
  tls:
    cert_file: ""
    key_file: ""

# The sections below (public names, prism_central, keycloak realm and
# client, oidc, tenants) are read from this file only until the settings
# have been stored: `portico settings import -config <this file>` moves
# them (and the secret files' contents) into the store, sealed with the
# master key; from then on the store wins and these sections, together
# with the secret files, can be removed. The setup pages of the admin UI
# edit the stored settings.
prism_central:
  url: https://10.0.0.10:9440    # required
  tls_verify: true               # false only in a lab
  ca_file: ""                    # CA that signed Prism Central's certificate
  # Service account "portico" (userType SERVICE_ACCOUNT, member of the
  # predefined Project Manager_acp policy) and its API key, one line in a
  # file with mode 0600 owned by the portico user.
  api_key_file: /etc/portico/prism-api-key        # required
  # The SAML identity provider in Prism Central that tenant projects are
  # shared with (exactly one with this name must exist).
  saml_idp_name: portico-keycloak                 # required

keycloak:
  url: http://127.0.0.1:8080     # backchannel; the browser uses id_host
  realm: portico                 # required: the MSP realm
  # Confidential client with "service accounts" enabled and these
  # realm-management roles on its service-account user: manage-users,
  # view-users, query-users, query-groups, view-realm, manage-realm (the
  # last one sets the realm's login theme).
  admin_client_id: portico-admin
  admin_client_secret_file: /etc/portico/keycloak-admin-secret  # required, mode 0600
  # Login theme generated from the branding settings. The directory is
  # owned by the portico user and mounted read-only into the Keycloak
  # container as /opt/keycloak/themes/<theme_name>; Keycloak runs with
  # KC_SPI_THEME_CACHE_THEMES=false, KC_SPI_THEME_CACHE_TEMPLATES=false
  # and KC_SPI_THEME_STATIC_MAX_AGE=-1 so a saved theme applies at once.
  theme_dir: /var/lib/portico/keycloak-theme
  theme_name: portico

oidc:
  # Keycloak client: confidential, standard flow, PKCE S256,
  # redirect URI https://<prism_host>/.portico/callback and
  # post-logout redirect URI https://<prism_host>/ (logout fails otherwise).
  issuer: https://id.msp.example/realms/portico  # required: as it appears in tokens
  client_id: portico                            # required
  client_secret_file: /etc/portico/oidc-client-secret  # required, mode 0600

session:
  max_age: 8h
  idle: 15m

policy:
  # Not configurable: on the public name every Authorization header is
  # refused (the console uses cookies only, measured on pc.7.6), as are
  # X-ntnx-api-key and the local-login paths.
  allow_prefixes:                # measured on pc.7.6; an entry ending in "/" is a prefix
    - /
    - /console/
    - /static/
    - /ui/iam/
    - /api/
    - /dm/
    - /PrismGateway/services/rest/v1/
    - /vnc/
    - /auth_code
    - /favicon.ico
    - /redirect                  # Prism Central's own Sign Out

log:
  level: info                    # debug, info, warn, error

store:
  path: /var/lib/portico/portico.db  # SQLite, WAL
  # Master key that seals the secrets in the store: created by the
  # service at first start (32 random bytes, mode 0600, owned by portico).
  # A backup is a copy of /var/lib/portico INCLUDING this file, kept
  # apart from the database copy; without the key the stored secrets
  # cannot be opened and the service refuses to start (the error names
  # the field; after systemd's start limit run `systemctl reset-failed
  # portico` once the key is back).
  master_key_file: /var/lib/portico/master.key

tenants:
  project_prefix: portico        # project name and id = <prefix>-<slug>; SP Central uses "sp"
  group_prefix: tenant-          # Keycloak and SAML group = <group_prefix><slug>
  role: Project Admin            # role bound inside the project, never a global role
  # Placement of each tenant's resource group. Ext ids from
  # GET /api/clustermgmt/v4.0/config/clusters and
  # GET /api/clustermgmt/v4.0/config/storage-containers.
  cluster_ext_id: 00000000-0000-0000-0000-000000000000           # required
  storage_container_ext_id: 00000000-0000-0000-0000-000000000000 # required
  operation_timeout: 10m         # one provisioning or deletion run; a run cut by a
                                 # restart (TimeoutStopSec=30 in the unit) is marked
                                 # failed at the next start, retry or delete it

# The break-glass account of the admin API ("admin") is set once with:
#   printf '%s\n' "$PW" | sudo -u portico portico admin set-password -config /etc/portico/portico.yaml
