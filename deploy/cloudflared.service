# Cloudflare tunnel connector, enabled by `portico exposure apply` in
# tunnel mode (design 4.6): the token given on the setup page lives in
# /etc/cloudflared/token (root, 0600) and never on a command line.
[Unit]
Description=Cloudflare tunnel connector for Portico
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The metrics address is pinned: `portico exposure apply` asks its /ready
# endpoint whether Cloudflare registered the connection.
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel --metrics 127.0.0.1:20241 run --token-file ${CREDENTIALS_DIRECTORY}/token
Restart=always
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LoadCredential=token:/etc/cloudflared/token

[Install]
WantedBy=multi-user.target
